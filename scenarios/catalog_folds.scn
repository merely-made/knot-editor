# Production catalog source is five bound files with six extracted links.
click role:button Graph
wait
assert snap graph_visible == true
assert snap catalog_folds == 0
assert snap catalog_visible_nodes == 5
capture catalog-expanded
click role:button Select documents for fold
click .graph-canvas-swatch-node @aria-label=LeafA
click .graph-canvas-swatch-node @aria-label=LeafB
assert snap catalog_fold_selection == 2
click role:button Fold selected
wait
assert snap catalog_folds == 1
assert snap catalog_visible_nodes == 4
assert snap catalog_fold_routes == 3
assert snap catalog_fold_cells == 5
capture catalog-one-fold
click role:button Undo fold
wait
assert snap catalog_folds == 0
capture catalog-undone
click role:button Redo fold
wait
assert snap catalog_folds == 1
capture catalog-redone
click role:button Select documents for fold
click .graph-canvas-swatch-node @aria-label=Other
click .graph-canvas-swatch-node @aria-label=LeafC
click role:button Fold selected
wait
assert snap catalog_folds == 2
assert snap catalog_visible_nodes == 3
assert snap catalog_fold_routes == 3
assert snap catalog_fold_cells == 5
capture catalog-two-folds
