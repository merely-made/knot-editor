# Knot with --mere-root/--mere-persona/--mere-domain divination against a
# disposable public-test-key Djinn fixture (3 sessions, empty archive), with
# both of the fixture's documents open and so catalogued. The sessions are
# nodes in the overmap tier on the catalog's canvas; the shown session's node
# opens in place into its card, and a saved codicil is an archive node whose
# popover holds Open as session. The card offers Branch beside Fork.
log knot overmap live: launched
wait
assert snap document_count == 2
click role:button Graph
wait
assert snap graph_open == true
assert text Catalog reading
assert text Evening reading
assert text Draft spread
assert text New session
assert text Compose selected archives
capture overmap-live-sessions
click .graph-canvas-swatch-node @aria-label=Session Session, shown here
wait
assert text Save to archive
assert text Branch
capture overmap-live-card-fork-branch
click role:button @aria-label=Save Session to archive
wait
click .graph-canvas-swatch-node @data-node-kind=archive
wait
assert text Open as session
capture overmap-live-after-save
log knot overmap live: done
