# Fresh Knot process against the same fixture: the saved codicil is read back
# from Djinn as an archive node in the overmap tier, opened as a session through
# its popover's Open control, and the thaw is then forked from its card.
log knot overmap reopen: launched
wait
click role:button Graph
wait
assert snap graph_open == true
assert text Evening reading
click .graph-canvas-swatch-node @data-node-kind=archive
wait
assert text Open as session
capture overmap-reopen-codicil-read-back
click role:button @data-step=open-archive
wait
assert snap graph_open == true
assert text Session (from blake3:
capture overmap-reopen-after-open
click .graph-canvas-swatch-node @data-attached=true
wait
click role:button @data-step=fork
wait
# Close the thaw card so its collision mask cannot hide the new fork label.
click role:button Close
wait
assert text Session (fork of
capture overmap-reopen-after-fork
log knot overmap reopen: done
