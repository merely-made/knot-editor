# Cargo output and isolated verification caches.
target/
target-*/
.cargo-*/
/crates/knot-document/Cargo.lock

# Local Cargo path overrides. A committed example may document the edit loop.
**/.cargo/*
!/.cargo/config.toml.example

# Local receipts, logs, and runtime state.
.tmp/
logs/
.test-logs/
.cargo-check-logs/
diagnostics-dump.txt
*.profraw
*.profdata
flamegraph.svg
perf.data*

# Editors, operating systems, and secrets.
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
**/*.rs.bk
.DS_Store
Thumbs.db
desktop.ini
.env
.env.local
.env.*.local
